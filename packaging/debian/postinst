#!/bin/sh
set -e
case "$1" in
    configure)
        if command -v py3compile >/dev/null 2>&1; then
            if [ -n "${DPKG_ROOT:-}" ]; then
                py3compile "$DPKG_ROOT/usr/lib/python3/dist-packages/tensegrity"
            else
                py3compile -p tensegrity-lm
            fi
        fi
        ;;
esac
exit 0
